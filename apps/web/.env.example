# API URL
VITE_API_URL=http://localhost:3000/api

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Culqi - Payment Gateway
# Obtén tus claves en: https://panel.culqi.com/
# Para desarrollo usa las claves de prueba (pk_test_...)
# Para producción usa las claves reales (pk_live_...)
VITE_CULQI_PUBLIC_KEY=pk_test_your_culqi_public_key_here

# PayPal - Payment Gateway
# Obtén tu Client ID en: https://developer.paypal.com/
# Para desarrollo usa el Sandbox Client ID
# Para producción usa el Live Client ID
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
