# Server
PORT=3000
NODE_ENV=development

# Database - MySQL (Laragon - Recomendado)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tudestino
DB_USER=root
DB_PASSWORD=

# Database - MongoDB (Alternativa)
# MONGODB_URI=mongodb://localhost:27017/tudestino

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Frontend URLs - Localhost (por defecto)
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:3000

# Frontend URLs - Laragon (descomentar si usas dominios .test)
# WEB_URL=http://tudestino.test
# ADMIN_URL=http://admin.tudestino.test
# API_URL=http://api.tudestino.test

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
